# Kopieren nach .env und Werte anpassen
PORT=3000

# Adminbereich, kein Nutzername noetig, nur ein Passwort
ADMIN_PASSWORD=bitte-aendern

# Zufaelliger, langer String zum Signieren der Session-Cookies
SESSION_SECRET=bitte-aendern-langer-zufallsstring

# Frontend-Origin fuer CORS im lokalen Dev-Betrieb (ng serve)
CLIENT_ORIGIN=http://localhost:4200

# "production" setzt das Session-Cookie auf secure (nur HTTPS)
NODE_ENV=development
